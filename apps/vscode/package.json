{
  "name": "atruneai",
  "displayName": "AtruneAI",
  "description": "Your AI workplace, inside VS Code. Brief your team, watch a 5-phase pipeline run, ship.",
  "version": "0.1.0",
  "publisher": "atrune-ai",
  "license": "AGPL-3.0",
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Monishraj50/GuideAI.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/Monishraj50/GuideAI/issues"
  },
  "homepage": "https://github.com/Monishraj50/GuideAI#readme",
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "claude",
    "openai",
    "workspace",
    "atruneai",
    "atrune",
    "founder",
    "no-code",
    "pipeline"
  ],
  "galleryBanner": {
    "color": "#0F2A4F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atrune",
          "title": "AtruneAI",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "atrune": [
        {
          "id": "atrune.welcome",
          "name": "Get started",
          "when": "!atrune.connected"
        },
        {
          "id": "atrune.activeWork",
          "name": "Active work",
          "icon": "$(target)",
          "when": "atrune.connected"
        },
        {
          "id": "atrune.progress",
          "name": "Progress tracker",
          "icon": "$(checklist)",
          "when": "atrune.connected"
        },
        {
          "id": "atrune.team",
          "name": "Team",
          "icon": "$(organization)",
          "when": "atrune.connected"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "atrune.welcome",
        "contents": "Welcome to **AtruneAI**.\n\nYour AI workplace. Connect a coding subscription to activate your team.\n\n[$(plug) Connect a subscription](command:atrune.connectSubscription)\n\nClaude · Copilot · Codex\n\n---\n\n[Show me around](command:atrune.showWalkthrough)"
      }
    ],
    "configuration": {
      "title": "AtruneAI",
      "properties": {
        "atrune.serverPort": {
          "type": "number",
          "default": 4000,
          "description": "Port the Fastify server listens on."
        },
        "atrune.webPort": {
          "type": "number",
          "default": 3000,
          "description": "Port the Next.js dev server listens on."
        },
        "atrune.autoSpawn": {
          "type": "boolean",
          "default": true,
          "description": "Auto-spawn the Atrune server + web on activation if they aren't already running."
        },
        "atrune.repoRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the Atrune monorepo root (auto-detected; override if running from a different location)."
        },
        "atrune.founderMode": {
          "type": "boolean",
          "default": false,
          "description": "Plain-English labels: status bar narrator and approval popups use friendlier words. Same data, different mood."
        },
        "atrune.showCostPreview": {
          "type": "boolean",
          "default": true,
          "description": "Show a cost-and-time preview popup before dispatching a brief. Turn off if you trust the budget caps."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "atrune.welcome",
        "title": "Welcome to AtruneAI",
        "description": "A 5-minute tour: brief your team, watch them work, ship.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome",
            "description": "Meet your AI workplace.",
            "media": { "markdown": "walkthrough/01-welcome.md" }
          },
          {
            "id": "sidebar",
            "title": "The sidebar",
            "description": "Three views, four buttons — the whole interface.",
            "media": { "markdown": "walkthrough/02-sidebar.md" }
          },
          {
            "id": "first-brief",
            "title": "Your first brief",
            "description": "Pick a template or write your own; watch the pipeline run.",
            "media": { "markdown": "walkthrough/03-first-brief.md" },
            "completionEvents": ["onCommand:atrune.newBrief"]
          },
          {
            "id": "direct-task",
            "title": "Quick ask & auto-fix",
            "description": "Skip the pipeline; ask one agent or fix one file.",
            "media": { "markdown": "walkthrough/04-direct-task.md" },
            "completionEvents": ["onCommand:atrune.quickAsk", "onCommand:atrune.autoFixThisFile"]
          },
          {
            "id": "founder-mode",
            "title": "Founder mode",
            "description": "Plain English if technical words aren't your daily vocab.",
            "media": { "markdown": "walkthrough/05-founder-mode.md" }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "atrune.newBrief",
        "title": "Atrune: New brief…",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "atrune.quickAsk",
        "title": "Atrune: Quick ask…",
        "icon": "$(zap)"
      },
      {
        "command": "atrune.openMissionControl",
        "title": "Atrune: Open Mission Control",
        "icon": "$(window)"
      },
      {
        "command": "atrune.openSettings",
        "title": "Atrune: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "atrune.refresh",
        "title": "Atrune: Refresh sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "atrune.restartServer",
        "title": "Atrune: Restart server"
      },
      {
        "command": "atrune.switchWorkspace",
        "title": "Atrune: Switch project…"
      },
      {
        "command": "atrune.askOneAgent",
        "title": "Atrune: Ask one agent…",
        "icon": "$(person)"
      },
      {
        "command": "atrune.autoFixThisFile",
        "title": "Atrune: Auto-fix this…",
        "icon": "$(wand)"
      },
      {
        "command": "atrune.askAgentAboutSelection",
        "title": "Atrune: Ask agent about this selection",
        "icon": "$(comment-add)"
      },
      {
        "command": "atrune.showWalkthrough",
        "title": "Atrune: Show me around"
      },
      {
        "command": "atrune.resetFirstLaunch",
        "title": "Atrune: Re-connect Claude (reset first-launch)"
      },
      {
        "command": "atrune.setRepoRoot",
        "title": "Atrune: Set monorepo folder…"
      },
      {
        "command": "atrune.connectSubscription",
        "title": "Atrune: Connect a subscription…",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atrune.newBrief",
          "when": "view == atrune.activeWork",
          "group": "navigation@1"
        },
        {
          "command": "atrune.quickAsk",
          "when": "view == atrune.activeWork",
          "group": "navigation@2"
        },
        {
          "command": "atrune.openMissionControl",
          "when": "view == atrune.activeWork",
          "group": "navigation@3"
        },
        {
          "command": "atrune.openSettings",
          "when": "view == atrune.activeWork",
          "group": "navigation@4"
        },
        {
          "command": "atrune.connectSubscription",
          "when": "view == atrune.activeWork || view == atrune.welcome",
          "group": "navigation@5"
        },
        {
          "command": "atrune.refresh",
          "when": "view == atrune.progress || view == atrune.team",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "atrune.autoFixThisFile",
          "when": "resourceScheme == file",
          "group": "atrune@1"
        }
      ],
      "editor/context": [
        {
          "command": "atrune.askAgentAboutSelection",
          "when": "editorHasSelection",
          "group": "atrune@1"
        },
        {
          "command": "atrune.autoFixThisFile",
          "when": "editorIsOpen",
          "group": "atrune@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@guideai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
