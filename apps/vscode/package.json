{
  "name": "@guideai/vscode",
  "displayName": "AtruneAI",
  "description": "Your AI workplace, inside VS Code. Brief your team, watch the pipeline, ship faster.",
  "version": "0.1.0",
  "publisher": "atrune-ai",
  "private": true,
  "license": "AGPL-3.0",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atrune",
          "title": "AtruneAI",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "atrune": [
        {
          "id": "atrune.activeWork",
          "name": "Active work",
          "icon": "$(target)"
        },
        {
          "id": "atrune.pending",
          "name": "Pending",
          "icon": "$(check)"
        },
        {
          "id": "atrune.team",
          "name": "Team",
          "icon": "$(organization)"
        }
      ]
    },
    "configuration": {
      "title": "AtruneAI",
      "properties": {
        "atrune.serverPort": {
          "type": "number",
          "default": 4000,
          "description": "Port the Fastify server listens on."
        },
        "atrune.webPort": {
          "type": "number",
          "default": 3000,
          "description": "Port the Next.js dev server listens on."
        },
        "atrune.autoSpawn": {
          "type": "boolean",
          "default": true,
          "description": "Auto-spawn the Atrune server + web on activation if they aren't already running."
        },
        "atrune.repoRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the Atrune monorepo root (auto-detected; override if running from a different location)."
        }
      }
    },
    "commands": [
      {
        "command": "atrune.newBrief",
        "title": "Atrune: New brief…",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "atrune.quickAsk",
        "title": "Atrune: Quick ask…",
        "icon": "$(zap)"
      },
      {
        "command": "atrune.openMissionControl",
        "title": "Atrune: Open Mission Control",
        "icon": "$(window)"
      },
      {
        "command": "atrune.openSettings",
        "title": "Atrune: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "atrune.refresh",
        "title": "Atrune: Refresh sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "atrune.restartServer",
        "title": "Atrune: Restart server"
      },
      {
        "command": "atrune.switchWorkspace",
        "title": "Atrune: Switch project…"
      },
      {
        "command": "atrune.askOneAgent",
        "title": "Atrune: Ask one agent…",
        "icon": "$(person)"
      },
      {
        "command": "atrune.autoFixThisFile",
        "title": "Atrune: Auto-fix this…",
        "icon": "$(wand)"
      },
      {
        "command": "atrune.askAgentAboutSelection",
        "title": "Atrune: Ask agent about this selection",
        "icon": "$(comment-add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atrune.newBrief",
          "when": "view == atrune.activeWork",
          "group": "navigation@1"
        },
        {
          "command": "atrune.quickAsk",
          "when": "view == atrune.activeWork",
          "group": "navigation@2"
        },
        {
          "command": "atrune.openMissionControl",
          "when": "view == atrune.activeWork",
          "group": "navigation@3"
        },
        {
          "command": "atrune.openSettings",
          "when": "view == atrune.activeWork",
          "group": "navigation@4"
        },
        {
          "command": "atrune.refresh",
          "when": "view == atrune.pending || view == atrune.team",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "atrune.autoFixThisFile",
          "when": "resourceScheme == file",
          "group": "atrune@1"
        }
      ],
      "editor/context": [
        {
          "command": "atrune.askAgentAboutSelection",
          "when": "editorHasSelection",
          "group": "atrune@1"
        },
        {
          "command": "atrune.autoFixThisFile",
          "when": "editorIsOpen",
          "group": "atrune@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@guideai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
